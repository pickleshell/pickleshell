[Unit]
Description=PickleShell Secure MCP Tunnel
After=network-online.target pickleshell-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=pickleshell-tunnel
Group=pickleshell-tunnel
WorkingDirectory=/opt/pickleshell/mcp-server
Environment=PATH=/opt/pickleshell/runtime/node-v20.20.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/pickleshell/mcp-home
Environment=XDG_CACHE_HOME=/var/cache/pickleshell/mcp
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/pickleshell/ms-playwright
EnvironmentFile=/etc/pickleshell/mcp.env
ExecStart=/usr/local/bin/tunnel-client run --profile-file /etc/pickleshell/tunnel-client/pickleshell.yaml
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
TasksMax=128
MemoryMax=1G
RuntimeDirectory=pickleshell-mcp
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/pickleshell/mcp-home
ReadWritePaths=/var/cache/pickleshell/mcp
ReadOnlyPaths=/opt/pickleshell
ReadOnlyPaths=/etc/pickleshell/tunnel-client/pickleshell.yaml
ReadOnlyPaths=/etc/pickleshell/control-plane.key
InaccessiblePaths=-/etc/pickleshell/gateway.env
InaccessiblePaths=-/etc/pickleshell/opencode.jsonc
InaccessiblePaths=-/etc/pickleshell/config.json
InaccessiblePaths=-/etc/pickleshell/mcp.env
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
