[Unit]
Description=PickleShell private Terminal PTY runtime
After=local-fs.target

[Service]
Type=simple
User=pickleshell-terminal
Group=pickleshell-terminal
ExecStart=/usr/bin/node /opt/pickleshell/active/terminal/src/server.js
Environment=PICKLESHELL_TERMINAL_CONFIG=/etc/pickleshell/terminal.json
Environment=PICKLESHELL_TERMINAL_SOCKET=/run/pickleshell-terminal/service.sock
Environment=PICKLESHELL_TERMINAL_ROOT_OVERRIDE=/run/pickleshell-terminal/workspace
RuntimeDirectory=pickleshell-terminal
RuntimeDirectoryMode=0750
Restart=on-failure
Delegate=yes
ProtectControlGroups=false
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
TasksMax=128
MemoryMax=1G
ReadWritePaths=/run/pickleshell-terminal
BindPaths=/srv/example/workspace:/run/pickleshell-terminal/workspace
ReadOnlyPaths=/opt/pickleshell/active/terminal

[Install]
WantedBy=multi-user.target
