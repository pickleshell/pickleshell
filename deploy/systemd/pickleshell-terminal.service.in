[Unit]
Description=PickleShell private Terminal PTY runtime
After=local-fs.target

[Service]
Type=simple
User=@TERMINAL_USER@
Group=@TERMINAL_GROUP@
ExecStart=@TERMINAL_NODE_EXECUTABLE@ @ACTIVE_ROOT@/terminal/src/server.js
Environment=PICKLESHELL_TERMINAL_CONFIG=@CONFIG_ROOT@/terminal.json
Environment=PICKLESHELL_TERMINAL_SOCKET=@TERMINAL_SOCKET@
Environment=PICKLESHELL_TERMINAL_ROOT_OVERRIDE=@TERMINAL_WORKSPACE_BIND_TARGET@
RuntimeDirectory=@TERMINAL_RUNTIME_NAME@
RuntimeDirectoryMode=0750
Restart=on-failure
Delegate=yes
ProtectControlGroups=false
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
PrivateTmp=true
TasksMax=128
MemoryMax=1G
ReadWritePaths=@TERMINAL_RUNTIME_DIR@
BindPaths=@TERMINAL_WORKSPACE_ROOT@:@TERMINAL_WORKSPACE_BIND_TARGET@
ReadOnlyPaths=@ACTIVE_ROOT@/terminal

[Install]
WantedBy=multi-user.target
