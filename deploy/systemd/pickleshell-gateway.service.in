[Unit]
Description=PickleShell Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StateDirectory=pickleshell-settings
StateDirectoryMode=0700
User=@GATEWAY_USER@
Group=@GATEWAY_GROUP@
WorkingDirectory=@ACTIVE_ROOT@/gateway
Environment=NODE_ENV=production
Environment=PATH=@NODE_BIN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=@STATE_ROOT@/agent-home
Environment=XDG_CONFIG_HOME=@STATE_ROOT@/config
Environment=XDG_DATA_HOME=@STATE_ROOT@/data
Environment=XDG_STATE_HOME=@STATE_ROOT@/state
Environment=XDG_CACHE_HOME=@CACHE_ROOT@/opencode
Environment=CODEX_HOME=@STATE_ROOT@/agent-home/.codex
Environment=OPENCODE_CONFIG_DIR=@STATE_ROOT@/config/opencode
Environment=SETTINGS_PATH=/var/lib/pickleshell-settings/settings.json
Environment=NPM_CONFIG_CACHE=@CACHE_ROOT@/npm
EnvironmentFile=@CONFIG_ROOT@/gateway.env
ExecStart=@NODE_EXECUTABLE@ src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
TasksMax=256
MemoryHigh=3G
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@WORKSPACE_ROOT@
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=@STATE_ROOT@/config/opencode
ReadWritePaths=/var/lib/pickleshell-settings
ReadWritePaths=@STATE_ROOT@/data/opencode
ReadWritePaths=@STATE_ROOT@/state/opencode
ReadWritePaths=@STATE_ROOT@/agent-home
ReadWritePaths=@CACHE_ROOT@/opencode
ReadWritePaths=@CACHE_ROOT@/npm
ReadWritePaths=@WORKSPACE_ROOT@
ReadOnlyPaths=@APP_ROOT@
ReadOnlyPaths=@CONFIG_ROOT@/config.json
ReadOnlyPaths=@CONFIG_ROOT@/opencode.jsonc
InaccessiblePaths=-@CONFIG_ROOT@/control-plane.key
InaccessiblePaths=-@CONFIG_ROOT@/mcp.env
InaccessiblePaths=-@CONFIG_ROOT@/gateway.env
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
