[Unit]
Description=PickleShell scoped memory credential broker
After=@BACKEND_SERVICE@
Requires=@BACKEND_SERVICE@

[Service]
Type=simple
User=@BROKER_USER@
Group=@BROKER_GROUP@
LoadCredential=backend.env:@BACKEND_ENV_FILE@
Environment=PICKLESHELL_MEMORY_BACKEND_ENV_FILE=%d/backend.env
ExecStart=@BROKER_WRAPPER@
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ReadOnlyPaths=@ACTIVE_ROOT@
ReadOnlyPaths=@CONFIG_ROOT@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
