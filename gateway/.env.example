# Local Agent Chat Gateway Configuration

# Required: Bearer token for authentication
# Generate with: openssl rand -base64 48
PICKLESHELL_API_KEY=lag_v1_your_long_random_secret_here

# Optional: Server configuration
PORT=18092
HOST=127.0.0.1
CONFIG_PATH=./config.json

# Optional: Message limits
MESSAGE_MAX_CHARS=300000
JSON_BODY_LIMIT=5mb

# Optional: Agent timeout
AGENT_TIMEOUT_SEC=300

# Optional: requests allowed per source IP in a 15-minute window
RATE_LIMIT_MAX=100
